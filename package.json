{
  "name": "myadmin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "build:web": "ng build web --configuration production",
    "dev": "bun run scripts/dev/start.ts",
    "dev:server": "bun run scripts/dev/start-server.ts",
    "dev:web": "bun run scripts/dev/start-web.ts",
    "stop:ports": "bun run scripts/dev/stop-ports.ts",
    "health": "bun run apps/server/src/main.ts",
    "myadmin": "bun run apps/cli/src/main.ts",
    "start": "bun run scripts/dev/start.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "version": "bun run apps/cli/src/main.ts version",
    "ng": "ng"
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "elysia": "^1.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.0",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.0",
    "@types/bun": "^1.2.20",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
