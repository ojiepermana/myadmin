{
  "name": "myadmin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "build:web": "ng build web --configuration production",
    "build:web:release": "bun run scripts/build/build-web.ts",
    "embed:web": "bun run scripts/build/embed-web-assets.ts",
    "build:binaries": "bun run scripts/build/compile-binary.ts",
    "checksums": "bun run scripts/build/checksums.ts",
    "release:changelog": "bun run scripts/release/changelog.ts",
    "release:sizes": "bun run scripts/build/report-sizes.ts",
    "smoke:binary": "bun run scripts/verify/smoke-binary.ts",
    "bundle:contract": "bun run scripts/bundle-contract.ts",
    "lint:ui-boundary": "bun run scripts/quality/check-ui-boundary.ts",
    "test:ui-boundary": "bun test scripts/quality/check-ui-boundary.spec.ts",
    "generate:contract-types": "bun run scripts/codegen/generate-contract-types.ts",
    "check:contract-drift": "bun run generate:contract-types && git diff --exit-code -- packages/api-contract/src/generated/",
    "test:contract": "bun run bundle:contract && bun test tests/contract",
    "security:scan-secrets": "bun run scripts/security/scan-secrets.ts",
    "security:authorization-matrix": "bun run scripts/security/generate-authorization-matrix.ts",
    "matrix:ac": "bun run scripts/quality/generate-ac-evidence-matrix.ts && bunx prettier --write docs/specs/ac-evidence-matrix.md",
    "test:security": "bun test tests/security scripts/security/scan-secrets.test.ts",
    "dev": "bun run scripts/dev/start.ts",
    "dev:server": "bun run scripts/dev/start-server.ts",
    "dev:web": "bun run scripts/dev/start-web.ts",
    "stop:ports": "bun run scripts/dev/stop-ports.ts",
    "health": "bun run apps/server/src/main.ts",
    "myadmin": "bun run apps/cli/src/main.ts",
    "test:cli-runtime": "bun test apps/cli/test/runtime.test.ts",
    "test:realtime": "bun test apps/server/test/realtime.test.ts tests/integration/realtime tests/security/realtime tests/contract/realtime.test.ts",
    "start": "bun run scripts/dev/start.ts",
    "prepare": "husky",
    "lint": "bun run scripts/quality/lint.ts",
    "format": "bun run scripts/quality/format.ts",
    "format:check": "bun run scripts/quality/format.ts --check",
    "typecheck": "bun run scripts/quality/typecheck.ts",
    "test": "bun run build:web && bun run bundle:contract && bun test --isolate --timeout=10000 --path-ignore-patterns='tests/e2e/**/*.spec.ts'",
    "test:e2e": "playwright test --config playwright.config.ts",
    "check:boundaries": "bun run scripts/verify/check-boundaries.ts",
    "check:manifests": "bun run scripts/verify/check-manifests.ts",
    "validate-contract": "bun run scripts/validate-contract.ts",
    "test:database-core": "bun test packages/database-core/test",
    "test:database-mysql": "bun test packages/database-mysql/test",
    "test:database-mysql:integration": "bun test tests/integration/mysql",
    "test:database-postgresql": "bun test packages/database-postgresql/test",
    "test:database-postgresql:integration": "bun test tests/integration/postgresql",
    "version": "bun run apps/cli/src/main.ts version",
    "test:internal-sqlite": "bun test packages/kernel/test tests/integration/internal-sqlite",
    "ng": "ng"
  },
  "dependencies": {
    "@angular/cdk": "22.1.4",
    "@angular/common": "22.1.4",
    "@angular/compiler": "22.1.4",
    "@angular/core": "22.1.4",
    "@angular/forms": "22.1.4",
    "@angular/platform-browser": "22.1.4",
    "@angular/router": "22.1.4",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@ojiepermana/angular": "22.1.7",
    "@sinclair/typebox": "0.34.52",
    "codemirror": "6.0.2",
    "elysia": "1.4.30",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.6",
    "@angular/cli": "22.1.6",
    "@angular/compiler-cli": "22.1.4",
    "@redocly/cli": "2.49.0",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/bun": "1.4.0",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.9.1",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "@tailwindcss/postcss": "4.3.0",
    "jsdom": "27.0.0",
    "ajv": "8",
    "ajv-formats": "3",
    "openapi-typescript": "7",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "yaml": "2.9.0",
    "typescript-eslint": "8.68.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,html,scss,json,yaml,yml,md}": [
      "bun run scripts/quality/format.ts",
      "bun run scripts/quality/lint.ts"
    ]
  }
}
